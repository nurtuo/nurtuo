{
  "name": "@nurtuo/flow-schema",
  "version": "0.0.0",
  "description": "Canonical Nurtuo flow format: JSON Schema and TypeScript types",
  "license": "Apache-2.0",
  "type": "module",
  
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "schema", "testdata"],
  "scripts": {
    "build": "node scripts/sync-schema.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync": "node scripts/sync-schema.mjs",
    "sync:check": "node scripts/sync-schema.mjs --check",
    "lint": "echo 'lint: TODO (eslint)'",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {},
  "devDependencies": { "ajv": "^8.17.1" }
}
