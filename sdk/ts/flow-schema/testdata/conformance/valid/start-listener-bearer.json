{
  "description": "http listener with bearer auth",
  "flow": {
    "schema": "nurtuo.flow/v1",
    "id": "t",
    "name": "T",
    "revision": 1,
    "steps": [
      {
        "id": "start",
        "kind": "start",
        "config": {
          "type": "listener",
          "connector": "http",
          "path": "/hook",
          "method": "POST",
          "auth": {
            "type": "bearer",
            "secret": "secret://hook-token"
          }
        }
      },
      {
        "id": "end",
        "kind": "stop",
        "config": {
          "status": 202
        }
      }
    ],
    "edges": {
      "start:default": "end"
    }
  },
  "expect": []
}
