            {
              "name": "a",
              "scope": "process",
              "value": "'x'"
            }
          ]
        }
      },
      {
        "id": "return",
        "kind": "returnDocuments",
        "config": {}
      }
    ],
    "edges": {
      "start:default": "msg",
      "msg:default": "props",
      "props:default": "return"
    }
  },
  "expect": []
