{
  "description": "start points nowhere",
  "flow": {
    "schema": "nurtuo.flow/v1",
    "id": "t",
    "name": "T",
    "revision": 1,
    "steps": [
      {
        "id": "start",
        "kind": "start",
        "config": {
          "type": "manual"
        }
      },
      {
        "id": "end",
        "kind": "stop",
        "config": {}
      }
    ],
    "edges": {
      "start:default": "nowhere"
    }
  },
  "expect": [
    {
      "severity": "error",
      "code": "edge.target_unknown",
      "path": "/edges/start:default",
      "stepId": "start"
    },
    {
      "severity": "warning",
      "code": "step.unreachable",
      "path": "/steps/1",
      "stepId": "end"
    }
  ]
}
