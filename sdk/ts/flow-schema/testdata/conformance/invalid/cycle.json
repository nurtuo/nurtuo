{
  "description": "two steps loop",
  "flow": {
    "schema": "nurtuo.flow/v1",
    "id": "t",
    "name": "T",
    "revision": 1,
    "steps": [
      {
        "id": "start",
        "kind": "start",
        "config": {
          "type": "manual"
        }
      },
      {
        "id": "a",
        "kind": "message",
        "config": {
          "template": "a"
        }
      },
      {
        "id": "b",
        "kind": "message",
        "config": {
          "template": "b"
        }
      },
      {
        "id": "end",
        "kind": "stop",
        "config": {}
      }
    ],
    "edges": {
      "start:default": "a",
      "a:default": "b",
      "b:default": "a"
    }
  },
  "expect": [
    {
      "severity": "error",
      "code": "flow.cycle",
      "path": "/steps/1",
      "stepId": "a"
    },
    {
      "severity": "error",
      "code": "flow.cycle",
      "path": "/steps/2",
      "stepId": "b"
    },
    {
      "severity": "warning",
      "code": "step.unreachable",
      "path": "/steps/3",
      "stepId": "end"
    }
  ]
}
