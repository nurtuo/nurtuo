{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nurtuo.com/schema/flow.v1.json",
  "title": "Nurtuo flow v1",
  "description": "Logic of one flow. Layout (canvas positions) is stored separately. Edges are keyed by 'stepId:port'; one outgoing edge per port.",
  "type": "object",
  "required": ["schema", "id", "name", "revision", "steps", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "nurtuo.flow/v1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "revision": { "type": "integer", "minimum": 0 },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "edges": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_-]+$" },
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "kind", "config"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "kind": {
          "enum": ["start", "connector", "queue", "map", "script", "message", "setProperties", "decision", "branch", "route", "tryCatch", "processCall", "notify", "stop", "returnDocuments"]
        },
        "label": { "type": "string" },
        "config": { "type": "object" }
      },
      "allOf": [
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "start" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/startConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "connector" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/connectorConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "queue" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/queueConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "map" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/mapConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "script" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/scriptConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "message" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/messageConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "setProperties" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/setPropertiesConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "decision" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/decisionConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "branch" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/branchConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "route" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/routeConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "tryCatch" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/tryCatchConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "processCall" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/processCallConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "notify" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/notifyConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "stop" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/stopConfig" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "returnDocuments" } } }, "then": { "properties": { "config": { "$ref": "#/$defs/returnDocumentsConfig" } } } }
      ]
    },
    "startConfig": {
      "description": "Trigger. Ports: default.",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["manual", "listener", "schedule", "queue"] },
        "connector": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "method": { "type": "string" },
        "queue": { "type": "string", "minLength": 1 },
        "cron": { "type": "string", "minLength": 1 },
        "auth": { "$ref": "#/$defs/listenerAuth" },
        "tls": { "$ref": "#/$defs/listenerTLS" },
        "insecure": { "type": "boolean", "description": "HTTP listener: allow binding a non-loopback address without auth." }
      },
      "allOf": [
        { "if": { "required": ["type"], "properties": { "type": { "const": "listener" } } }, "then": { "required": ["connector"] } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "queue" } } }, "then": { "required": ["queue"] } },
        { "if": { "required": ["type"], "properties": { "type": { "const": "schedule" } } }, "then": { "required": ["cron"] } }
      ]
    },
    "secretRef": {
      "description": "Reference to a runtime secret; literal secret values are never stored in a flow.",
      "type": "string",
      "pattern": "^secret://[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "listenerAuth": {
      "description": "HTTP listener authentication. bearer: the secret as an Authorization Bearer token. apiKey: the secret in header (default X-API-Key). hmac: HMAC of the raw body, keyed with the secret, in header (default X-Signature).",
      "type": "object",
      "required": ["type", "secret"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["bearer", "apiKey", "hmac"] },
        "secret": { "$ref": "#/$defs/secretRef" },
        "header": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "algorithm": { "enum": ["sha256", "sha512"] },
        "encoding": { "enum": ["hex", "base64"] },
        "prefix": { "type": "string" }
      }
    },
    "listenerTLS": {
      "description": "HTTP listener TLS (minimum TLS 1.2): PEM certificate chain and private key from secrets.",
      "type": "object",
      "required": ["cert", "key"],
      "additionalProperties": false,
      "properties": {
        "cert": { "$ref": "#/$defs/secretRef" },
        "key": { "$ref": "#/$defs/secretRef" }
      }
    },
    "connectorConfig": {
      "description": "Connector step shell (operation against an external system). Ports: default.",
      "type": "object",
      "required": ["connector", "operation"],
      "additionalProperties": false,
      "properties": {
        "connector": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "objectType": { "type": "string" },
        "connection": { "type": "string" }
      }
    },
    "queueConfig": {
      "description": "Queue step shell (publish to a queue component). Ports: default.",
      "type": "object",
      "required": ["queue", "operation"],
      "additionalProperties": false,
      "properties": {
        "queue": { "type": "string", "minLength": 1 },
        "operation": { "enum": ["publish"] }
      }
    },
    "mapConfig": {
      "description": "Map step shell; compiled to JSONata. Ports: default.",
      "type": "object",
      "required": ["jsonata"],
      "additionalProperties": false,
      "properties": { "jsonata": { "type": "string", "minLength": 1 } }
    },
    "scriptConfig": {
      "description": "Runs a sandboxed WASM script over each document. Ports: default.",
      "type": "object",
      "required": ["script"],
      "additionalProperties": false,
      "properties": {
        "script": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "memoryMiB": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["clock", "random"] } }
      }
    },
    "messageConfig": {
      "description": "Sets the document body from a template. Ports: default.",
      "type": "object",
      "required": ["template"],
      "additionalProperties": false,
      "properties": { "template": { "type": "string" } }
    },
    "setPropertiesConfig": {
      "description": "Sets document or process properties from CEL expressions. Ports: default.",
      "type": "object",
      "required": ["properties"],
      "additionalProperties": false,
      "properties": {
        "properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "scope": { "enum": ["document", "process"] },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "decisionConfig": {
      "description": "Boolean CEL condition. Ports: true, false.",
      "type": "object",
      "required": ["cel"],
      "additionalProperties": false,
      "properties": { "cel": { "type": "string", "minLength": 1 } }
    },
    "branchConfig": {
      "description": "Runs paths sequentially. Ports: '1'..'<paths>'.",
      "type": "object",
      "required": ["paths"],
      "additionalProperties": false,
      "properties": { "paths": { "type": "integer", "minimum": 2, "maximum": 25 } }
    },
    "routeConfig": {
      "description": "Sends documents to the first matching route. Ports: each route id, then default.",
      "type": "object",
      "required": ["routes"],
      "additionalProperties": false,
      "properties": {
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "cel"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
              "cel": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "tryCatchConfig": {
      "description": "Ports: try, catch.",
      "type": "object",
      "additionalProperties": false,
      "properties": { "retries": { "type": "integer", "minimum": 0, "maximum": 10 } }
    },
    "processCallConfig": {
      "description": "Calls another flow by id. Ports: default.",
      "type": "object",
      "required": ["flow"],
      "additionalProperties": false,
      "properties": {
        "flow": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "notifyConfig": {
      "description": "Sends a notification. Ports: default.",
      "type": "object",
      "required": ["channel"],
      "additionalProperties": false,
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "template": { "type": "string" }
      }
    },
    "stopConfig": {
      "description": "Ends the run. Terminal: no ports.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "message": { "type": "string" }
      }
    },
    "returnDocumentsConfig": {
      "description": "Returns the current documents to the caller. Terminal: no ports.",
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  }
}
