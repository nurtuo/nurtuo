{
  "name": "@nurtuo/client",
  "version": "0.0.0",
  "description": "Typed client for the Nurtuo public API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./testing": { "types": "./dist/testing.d.ts", "default": "./dist/testing.js" }
  },
  "files": ["dist"],
  "scripts": {
    "gen": "node scripts/gen-types.mjs",
    "gen:check": "node scripts/gen-types.mjs --check",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: TODO (eslint)'",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {"@nurtuo/flow-schema": "workspace:*"},
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
