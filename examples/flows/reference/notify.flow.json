{
  "schema": "nurtuo.flow/v1",
  "id": "ref-notify",
  "name": "Reference: notify",
  "description": "Send a notification.",
  "revision": 1,
  "steps": [
    {
      "id": "start",
      "kind": "start",
      "config": {
        "type": "manual"
      }
    },
    {
      "id": "alert",
      "kind": "notify",
      "config": {
        "channel": "ops",
        "template": "Order {{doc.id}} processed"
      }
    },
    {
      "id": "done",
      "kind": "returnDocuments",
      "config": {}
    }
  ],
  "edges": {
    "start:default": "alert",
    "alert:default": "done"
  }
}
