{
  "schema": "nurtuo.flow/v1",
  "id": "ref-connector",
  "name": "Reference: connector",
  "description": "Call an HTTP connector operation.",
  "revision": 1,
  "steps": [
    {
      "id": "start",
      "kind": "start",
      "config": {
        "type": "manual"
      }
    },
    {
      "id": "call",
      "kind": "connector",
      "config": {
        "connector": "http",
        "operation": "GET",
        "connection": "orders-api"
      }
    },
    {
      "id": "done",
      "kind": "returnDocuments",
      "config": {}
    }
  ],
  "edges": {
    "start:default": "call",
    "call:default": "done"
  }
}
