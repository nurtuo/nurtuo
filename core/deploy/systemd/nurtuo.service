# Template written by `nurtuo service install`; shown here for packaging (deb/rpm).
[Unit]
Description=Nurtuo runtime
After=network-online.target
Wants=network-online.target

[Service]
User=nurtuo
ExecStart=/usr/bin/nurtuo run --config /etc/nurtuo/runtime.yaml
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
